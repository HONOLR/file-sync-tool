; ==========================================================================
; 通用增量文件同步工具 - 服务端配置文件(示例)
; ==========================================================================
; 使用方法:
;   1. 把本文件复制为 server_config.ini;
;   2. 按下面的注释修改各项配置;
;   3. 运行 python sync_server.py 启动服务端。
;
; 提示:
;   直接运行 sync_server.py 而不创建 server_config.ini 时, 程序会
;   自动生成一份带随机令牌的配置模板, 通常比手工复制本文件更方便。
;
; 注意:
;   server_config.ini 内含访问令牌和本机真实路径, 已被 .gitignore
;   排除, 请不要提交到代码仓库。
; ==========================================================================

[server]
; 监听地址。
;   127.0.0.1 表示只允许本机访问;
;   0.0.0.0   表示允许局域网/公网访问。
host = 127.0.0.1

; 监听端口。
port = 8000

; 访问令牌。客户端必须携带完全一致的令牌才能调用接口。
; 要求至少 16 个字符。可用下面的命令生成一个随机令牌:
;   python -c "import secrets; print(secrets.token_urlsafe(32))"
token = 这里替换成你自己生成的随机令牌

; 是否在日志中打印每一次文件下载请求。
; 数据集文件数量很多时建议设为 false, 以免日志过于嘈杂。
log_downloads = true

; ==========================================================================
; 数据集配置
; ==========================================================================
; 除 [server] 之外, 每一个段都代表一个数据集。
; 段名就是客户端请求时使用的数据集名称, 只允许使用字母、数字、
; 点、下划线和连字符。可以复制多份以提供多个数据集。
; ==========================================================================

; 示例一: 只同步目录下形如 A001、A002 的子目录, 并排除 A000
[example-dataset]
; 该数据集在服务端的真实目录。
; 支持相对路径(相对于本配置文件所在目录)和绝对路径两种写法。
location = share/example-dataset

; 只同步名称匹配该正则的一级子目录。留空表示同步全部内容。
include_dirs = ^A\d+$

; 需要排除的一级子目录名, 多个之间用逗号分隔。留空表示不排除。
exclude_dirs = A000

; 示例二: 同步整个目录下的所有文件(两个过滤项都留空)
;[full-dataset]
;location = D:\data\full-dataset
;include_dirs =
;exclude_dirs =

; 示例三: 只同步 assets 和 config 两个子目录
;[partial-dataset]
;location = /srv/data/partial
;include_dirs = ^assets$, ^config$
;exclude_dirs =
