; ==========================================================================
; 通用增量文件同步工具 - 客户端配置文件(示例)
; ==========================================================================
; 使用方法:
;   1. 把本文件复制为 config.ini;
;   2. 按下面的注释修改各项配置;
;   3. 运行 python sync_client.py 开始同步。
;
; 提示:
;   直接运行 sync_client.py 而不创建 config.ini 时, 程序会自动
;   生成一份配置模板。
;
; 注意:
;   config.ini 内含访问令牌和本机真实路径, 已被 .gitignore 排除,
;   请不要提交到代码仓库。
; ==========================================================================

[server]
; 服务端地址, 需要包含协议和端口。
;   示例: http://127.0.0.1:8000
;   示例: http://192.168.1.10:8000
;   示例: https://sync.example.com
url = http://127.0.0.1:8000

; 访问令牌, 必须与服务端 server_config.ini 中的 token 完全一致。
token = 这里替换成服务端配置里的访问令牌

; 要同步的数据集名称, 对应服务端配置文件里的段名。
; 不确定可用名称时, 可执行 `python sync_client.py --list` 查询。
dataset = example-dataset

; 单个请求的超时时间(秒)。网络较慢或文件较大时可适当调大。
timeout = 30

; 单个文件下载失败后的重试次数。
retries = 3

[local]
; 本地同步目录: 服务端的文件会按相对路径还原到该目录下。
; 目录不存在时会自动创建。
; 支持相对路径(相对于本配置文件所在目录)和绝对路径两种写法。
;   相对路径示例: download_dir = data
;   绝对路径示例: download_dir = D:\data\example-dataset
download_dir = data

; 客户端标识, 会随注册请求一起上报, 方便在服务端日志里区分来源。
; 留空则自动使用本机计算机名。
client_name =
